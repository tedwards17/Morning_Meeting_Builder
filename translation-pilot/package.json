{
  "name": "morning-meeting-builder",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "pilot": "vite --config vite.config.ts --mode pilot",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/src tests/frontend",
    "test": "vitest run --config vitest.config.ts",
    "build:demo": "python3 scripts/clean-build.py demo && vite build --mode demo && python3 scripts/sw.py build/demo",
    "build:hosted": "python3 scripts/clean-build.py hosted && vite build --mode hosted && python3 scripts/sw.py build/hosted",
    "package": "python3 scripts/package.py",
    "check:php": "python3 scripts/check_php.py"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "lucide-react": "1.46.0",
    "microsoft-cognitiveservices-speech-sdk": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "fake-indexeddb": "6.2.5",
    "playwright": "^1.63.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
